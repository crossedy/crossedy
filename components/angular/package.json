{
	"name": "@crossedy/angular",
	"version": "0.0.0",
	"scripts": {
		"install-dev": "npm install && run-p _install-dev:**",
		"_install-dev:link_common": "rm -f src/common && ln -s ../../common src/common",
		"_install-dev:link-crossedy": "../../bin/link-crossedy.mjs",
		"ng": "ng",
		"dev": "ng serve",
		"build": "ng build lib"
	},
	"prettier": {
		"printWidth": 100,
		"singleQuote": true,
		"overrides": [
			{
				"files": "*.html",
				"options": {
					"parser": "angular"
				}
			}
		]
	},
	"private": true,
	"dependencies": {
		"@angular/common": "^20.3.0",
		"@angular/compiler": "^20.3.0",
		"@angular/core": "^20.3.0",
		"@angular/forms": "^20.3.0",
		"@angular/platform-browser": "^20.3.0",
		"@angular/router": "^20.3.0",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	},
	"devDependencies": {
		"@angular/build": "^20.3.3",
		"@angular/cli": "^20.3.3",
		"@angular/compiler-cli": "^20.3.0",
		"typescript": "~5.9.2"
	}
}
