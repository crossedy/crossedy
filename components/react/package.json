{
	"name": "@crossedy/react",
	"version": "0.1.8",
	"type": "module",
	"main": "./dist/cjs/index.cjs",
	"module": "./dist/esm/index.mjs",
	"types": "./dist/types/index.d.ts",
	"unpkg": "./dist/umd/crossedy.react.js",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.mjs",
			"require": "./dist/cjs/index.cjs"
		},
		"./umd/*": {
			"default": "./dist/umd/*"
		},
		"./css/*": {
			"default": "./dist/css/*"
		}
	},
	"scripts": {
		"install-dev": "npm install && run-p _install-dev:**",
		"_install-dev:rollup": "cp ../../rollup.common.mjs ./.rollup.common.mjs",
		"_install-dev:link_common": "rm -f src/common && ln -s ../../common src/common",
		"_install-dev:link-crossedy": "../../bin/link-crossedy.mjs",
		"build": "run-s clean _build:**",
		"_build:0:lib": "rollup -c",
		"_build:1:full-combine": "cat node_modules/@crossedy/wrapper-react/dist/umd/crossedy.wrapper-react.full.js dist/umd/crossedy.react.js > dist/umd/crossedy.react.full.js",
		"_build:2:min": "terser  dist/umd/crossedy.react.js --compress --mangle -o dist/umd/crossedy.react.min.js",
		"_build:2:full-min": "terser  dist/umd/crossedy.react.full.js --compress --mangle -o dist/umd/crossedy.react.full.min.js",
		"clean": "rm -rf dist",
		"lint": "eslint .",
		"dev": "vite  --force"
	},
	"author": "Damien Duboeuf <smeagolworms4@gmail.com>",
	"license": "MIT",
	"dependencies": {
		"@crossedy/wrapper-react": "^0.1.12"
	},
	"peerDependencies": {
		"react": "^19.1.1",
		"react-dom": "^19.1.1"
	},
	"devDependencies": {
		"@babel/core": "^7.28.4",
		"@babel/preset-env": "^7.28.3",
		"@babel/preset-react": "^7.27.1",
		"@babel/preset-typescript": "^7.27.1",
		"@crossedy/unplugin-react": "^0.1.1",
		"@eslint/js": "^9.36.0",
		"@rollup/plugin-babel": "^6.0.4",
		"@rollup/plugin-typescript": "^12.1.4",
		"@types/node": "^24.5.2",
		"@types/react": "^19.1.13",
		"@types/react-dom": "^19.1.9",
		"@vitejs/plugin-react": "^5.0.3",
		"eslint": "^9.36.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^16.4.0",
		"npm-run-all": "^4.1.5",
		"rollup-plugin-scss": "^4.0.1",
		"rollup-plugin-tsconfig-paths": "^1.5.2",
		"sass": "^1.93.2",
		"terser": "^5.44.0",
		"tsc-alias": "^1.8.16",
		"tslib": "^2.8.1",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.44.0",
		"vite": "^7.1.7"
	},
	"files": [
		"dist",
		"README.md"
	]
}
