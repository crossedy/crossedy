{
	"name": "@crossedy/unplugin-react",
	"version": "0.1.0",
	"description": "React compiler for Crossedy",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.mjs",
			"require": "./dist/cjs/index.cjs"
		}
	},
	"scripts": {
		"install-dev": "npm install && run-p _install-dev:**",
		"_install-dev:rollup": "cp ../../rollup.common.mjs ./.rollup.common.mjs",
		"_install-dev:link-crossedy": "../../bin/link-crossedy.mjs",
		"build": "run-s clean _build:**",
		"_build:0:lib": "rollup -c",
		"clean": "rm -rf dist"
	},
	"author": "Damien Duboeuf <smeagolworms4@gmail.com>",
	"license": "MIT",
	"dependencies": {
		"@crossedy/compiler-react": "^0.1.0",
		"@rollup/pluginutils": "^5.3.0",
		"unplugin": "^2.3.10"
	},
	"devDependencies": {
		"@rollup/plugin-typescript": "^12.1.4",
		"@types/node": "^24.5.2",
		"npm-run-all": "^4.1.5",
		"rollup": "^4.52.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.2"
	},
	"files": [
		"dist",
		"README.md"
	]
}
