{
	"name": "@crossedy/wrapper-react",
	"version": "0.1.12",
	"description": "React component-wrapper for Crossedy",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.mjs",
			"require": "./dist/cjs/index.cjs"
		},
		"./umd/*": {
			"default": "./dist/umd/*"
		}
	},
	"scripts": {
		"install-dev": "npm install && run-p _install-dev:**",
		"_install-dev:rollup": "cp ../../rollup.common.mjs ./.rollup.common.mjs",
		"_install-dev:link-crossedy": "../../bin/link-crossedy.mjs",
		"build": "run-s clean _build:**",
		"_build:0:lib": "rollup -c",
		"_build:1:full-combine": "cat node_modules/@crossedy/wrapper-common/dist/umd/crossedy.wrapper-common.js dist/umd/crossedy.wrapper-react.js > dist/umd/crossedy.wrapper-react.full.js",
		"_build:2:min": "terser  dist/umd/crossedy.wrapper-react.js --compress --mangle -o dist/umd/crossedy.wrapper-react.min.js",
		"_build:2:full-min": "terser  dist/umd/crossedy.wrapper-react.full.js --compress --mangle -o dist/umd/crossedy.wrapper-react.full.min.js",
		"clean": "rm -rf dist"
	},
	"author": "Damien Duboeuf <smeagolworms4@gmail.com>",
	"license": "MIT",
	"dependencies": {
		"@crossedy/wrapper-common": "^0.1.7"
	},
	"peerDependencies": {
		"react": "^19.1.1",
		"react-dom": "^19.1.1"
	},
	"devDependencies": {
		"@babel/core": "^7.28.4",
		"@babel/preset-env": "^7.28.3",
		"@babel/preset-react": "^7.27.1",
		"@babel/preset-typescript": "^7.27.1",
		"@rollup/plugin-babel": "^6.0.4",
		"@rollup/plugin-typescript": "^12.1.4",
		"@types/node": "^24.5.2",
		"@types/react": "^19.1.13",
		"@types/react-dom": "^19.1.9",
		"npm-run-all": "^4.1.5",
		"rollup": "^4.52.0",
		"rollup-plugin-tsconfig-paths": "^1.5.2",
		"terser": "^5.44.0",
		"tsc-alias": "^1.8.16",
		"tslib": "^2.8.1",
		"typescript": "^5.9.2"
	},
	"files": [
		"dist",
		"README.md"
	]
}
